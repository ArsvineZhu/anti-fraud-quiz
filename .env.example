# Vercel production/preview settings
ADMIN_PIN=replace-with-a-private-event-pin
# With the Vercel Upstash integration prefix set to QUIZ_:
QUIZ_KV_REST_API_URL=
QUIZ_KV_REST_API_TOKEN=
PUBLIC_BASE_URL=https://quiz.arsvine.com

# Optional: use a different Redis namespace for another event
QUIZ_REDIS_PREFIX=anti-fraud-quiz

# Local development only; Vercel uses Redis automatically
QUIZ_STORAGE=memory
PORT=3000
